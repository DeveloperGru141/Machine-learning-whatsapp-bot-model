# Primary LLM Provider ('groq' or 'openrouter')
LLM_PROVIDER=groq

# Groq API Configuration (Supports comma-separated keys for automatic multi-key pool rotation: key1,key2)
GROQ_API_KEY=your_groq_api_key_1,your_groq_api_key_2
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=512
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=low

# Pairing Method: 'code' requires PAIRING_PHONE_NUMBER; 'qr' does not.
PAIRING_METHOD=code
PAIRING_PHONE_NUMBER=07058967815

# Bot Identity & Behavior
BOT_NAME="Forgelabs assistant"
BOT_CREATOR="ADEMOLA"
BOT_PREFIX=""
BOT_VOICE="en-NG-AbeoNeural"

# Bot Owner Numbers & JIDs (Comma-separated)
BOT_OWNERS=08108574293,2348108574293,102409552584830@lid

# Server Health Check Port & Storage Paths
PORT=3000
SESSIONS_DIR=./sessions
DATABASE_PATH=./data/bot.sqlite

# Optional remote persistence. Keep the auth token in Render's secret file,
# never in this example file or source control.
TURSO_SECRETS_FILE=/etc/secrets/turso.env
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Render Cloud Session Sync & Auto-Backup
RENDER_API_KEY=
RENDER_SERVICE_ID=srv-dbnges6417fc73dmuec0

