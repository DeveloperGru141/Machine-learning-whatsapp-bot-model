# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=1
GROQ_MAX_TOKENS=2048
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=medium

# Pairing Method: 'code' (8-character phone pairing code) or 'qr' (terminal QR code)
PAIRING_METHOD=code
PAIRING_PHONE_NUMBER= # e.g. 2348012345678 (leave empty to prompt in terminal)

# Bot Identity & Behavior
BOT_NAME="Nova"
BOT_CREATOR="ADEMOLA"
BOT_PREFIX="" # Empty for pure agentic tool-calling

# Bot Owner Numbers (Comma-separated phone numbers with country code, e.g. 2348012345678)
BOT_OWNERS=

# Sessions & Storage Paths
SESSIONS_DIR=./sessions
DATABASE_PATH=./data/bot.sqlite
STICKERS_DIR=./assets/stickers

# Sticker Autoreply Tuning
# Probability of sending a contextual sticker alongside or in place of text (0.0 to 1.0)
STICKER_REPLY_PROBABILITY=0.65
