# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=low

# Pairing Method: 'code' (8-character phone pairing code) or 'qr' (terminal QR code)
PAIRING_METHOD=code
PAIRING_PHONE_NUMBER=09014896714

# Bot Identity & Behavior
BOT_NAME="Forgelabs assistant"
BOT_CREATOR="ADEMOLA"
BOT_PREFIX="" # Empty for pure agentic tool-calling

# Bot Owner Numbers (Comma-separated phone numbers with country code, e.g. 2348012345678)
BOT_OWNERS=

# Sessions & Storage Paths
SESSIONS_DIR=./sessions
DATABASE_PATH=./data/bot.sqlite
