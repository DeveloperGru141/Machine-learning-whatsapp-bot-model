{
  "name": "whatsapp-modular-bot",
  "version": "1.0.0",
  "description": "Agentic WhatsApp Bot with Groq-powered tool-calling, continuous chat learning, and modular plugins",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "ingest": "uv run --python 3.15 python scripts/ingest_chats.py",
    "validate-data": "uv run --python 3.15 python scripts/validate_and_finetune.py",
    "test": "node test_new_features.cjs && node test_boss_relay.mjs && node test_group_admin.mjs && node test_anti_hallucination.cjs && node scripts/test_all_harness_tools.cjs"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "groq",
    "agent",
    "tool-calling",
    "plugins"
  ],
  "author": "ADEMOLA",
  "license": "ISC",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@gradio/client": "^2.7.1",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "@whiskeysockets/baileys": "^6.7.12",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "groq-sdk": "^0.15.0",
    "node-cron": "^3.0.3",
    "openai": "^7.34.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "rahad-all-downloader-v2": "^2.14.1",
    "sharp": "^0.33.5",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
